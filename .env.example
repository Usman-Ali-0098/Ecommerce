# Stripe sandbox only. Live keys are intentionally rejected by the application.
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Use "socket" with the custom local dev server and "polling" on Vercel.
# Production defaults to polling when this variable is omitted.
NEXT_PUBLIC_NOTIFICATION_TRANSPORT=socket
